<!-- Timeline. Shown in the widget picker: sample content, since previews get no data. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_card" android:tint="@color/wp_card" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.2"
        android:src="@drawable/widget_card_tint" android:tint="@color/wp_primary" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingTop="10dp" android:paddingBottom="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <TextView android:layout_height="wrap_content" android:text="9 AM" android:textSize="11sp" android:textColor="@color/wp_muted" android:maxLines="1" android:ellipsize="end" android:layout_width="44dp" android:gravity="end" android:paddingEnd="8dp" />
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:paddingEnd="12dp">
                <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="7dp" android:src="@drawable/widget_line" android:tint="@color/wp_line" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="8dp" android:layout_marginBottom="1dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_chip" android:tint="@color/wp_event_chip" android:scaleType="fitXY" android:importantForAccessibility="no" />
                    <ImageView android:layout_width="3dp" android:layout_height="match_parent" android:src="@drawable/widget_chip_edge" android:tint="@color/wp_event" android:scaleType="fitXY" android:importantForAccessibility="no" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingTop="4dp">
                        <ImageView android:layout_width="12dp" android:layout_height="12dp" android:layout_marginEnd="5dp" android:src="@drawable/ic_kind_meeting" android:tint="@color/wp_event" android:importantForAccessibility="no" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Team meeting" android:textSize="13sp" android:textColor="@color/wp_fg" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9 – 10 AM" android:textSize="11sp" android:textColor="@color/wp_muted" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="6dp" />
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <TextView android:layout_height="wrap_content" android:text="10 AM" android:textSize="11sp" android:textColor="@color/wp_muted" android:maxLines="1" android:ellipsize="end" android:layout_width="44dp" android:gravity="end" android:paddingEnd="8dp" />
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:paddingEnd="12dp">
                <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="7dp" android:src="@drawable/widget_line" android:tint="@color/wp_line" android:scaleType="fitXY" android:importantForAccessibility="no" />
            </FrameLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <TextView android:layout_height="wrap_content" android:text="11 AM" android:textSize="11sp" android:textColor="@color/wp_muted" android:maxLines="1" android:ellipsize="end" android:layout_width="44dp" android:gravity="end" android:paddingEnd="8dp" />
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:paddingEnd="12dp">
                <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="7dp" android:src="@drawable/widget_line" android:tint="@color/wp_line" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="8dp" android:layout_marginBottom="1dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_chip" android:tint="@color/wp_task_chip" android:scaleType="fitXY" android:importantForAccessibility="no" />
                    <ImageView android:layout_width="3dp" android:layout_height="match_parent" android:src="@drawable/widget_chip_edge" android:tint="@color/wp_task" android:scaleType="fitXY" android:importantForAccessibility="no" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingTop="4dp">
                        <ImageView android:layout_width="12dp" android:layout_height="12dp" android:layout_marginEnd="5dp" android:src="@drawable/ic_kind_task" android:tint="@color/wp_task" android:importantForAccessibility="no" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Send the budget" android:textSize="13sp" android:textColor="@color/wp_fg" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="11 AM" android:textSize="11sp" android:textColor="@color/wp_muted" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="6dp" />
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <TextView android:layout_height="wrap_content" android:text="12 PM" android:textSize="11sp" android:textColor="@color/wp_muted" android:maxLines="1" android:ellipsize="end" android:layout_width="44dp" android:gravity="end" android:paddingEnd="8dp" />
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:paddingEnd="12dp">
                <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="7dp" android:src="@drawable/widget_line" android:tint="@color/wp_line" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="8dp" android:layout_marginBottom="1dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_chip" android:tint="@color/wp_primary_chip" android:scaleType="fitXY" android:importantForAccessibility="no" />
                    <ImageView android:layout_width="3dp" android:layout_height="match_parent" android:src="@drawable/widget_chip_edge" android:tint="@color/wp_primary" android:scaleType="fitXY" android:importantForAccessibility="no" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingTop="4dp">
                        <ImageView android:layout_width="12dp" android:layout_height="12dp" android:layout_marginEnd="5dp" android:src="@drawable/ic_kind_event" android:tint="@color/wp_primary" android:importantForAccessibility="no" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lunch with Sam" android:textSize="13sp" android:textColor="@color/wp_fg" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12 – 1 PM" android:textSize="11sp" android:textColor="@color/wp_muted" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="6dp" />
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <TextView android:layout_height="wrap_content" android:text="1 PM" android:textSize="11sp" android:textColor="@color/wp_muted" android:maxLines="1" android:ellipsize="end" android:layout_width="44dp" android:gravity="end" android:paddingEnd="8dp" />
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:paddingEnd="12dp">
                <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="7dp" android:src="@drawable/widget_line" android:tint="@color/wp_line" android:scaleType="fitXY" android:importantForAccessibility="no" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
