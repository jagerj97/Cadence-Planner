<!-- Agenda. Shown in the widget picker: sample content, since previews get no data. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_card" android:tint="@color/wp_card" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.2"
        android:src="@drawable/widget_card_tint" android:tint="@color/wp_primary" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" >
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="10dp" android:paddingTop="10dp" android:paddingBottom="4dp">
        <TextView android:layout_height="wrap_content" android:text="Agenda" android:textSize="15sp" android:textColor="@color/wp_fg" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" android:layout_width="0dp" android:textStyle="bold" />
        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:padding="6dp" android:src="@drawable/ic_plus" android:tint="@color/wp_muted" android:importantForAccessibility="no" />
    </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Today" android:textSize="13sp" android:textColor="@color/wp_primary" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:paddingStart="16dp" android:paddingTop="6dp" android:paddingBottom="2dp" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="3dp" android:layout_marginBottom="3dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_chip" android:tint="@color/wp_event_chip" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <ImageView android:layout_width="3dp" android:layout_height="match_parent" android:src="@drawable/widget_chip_edge" android:tint="@color/wp_event" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="10dp" android:paddingTop="6dp" android:paddingBottom="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="6dp" android:src="@drawable/ic_kind_meeting" android:tint="@color/wp_event" android:importantForAccessibility="no" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Team meeting" android:textSize="14sp" android:textColor="@color/wp_fg" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9 AM – 10 AM" android:textSize="12sp" android:textColor="@color/wp_muted" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="3dp" android:layout_marginBottom="3dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_chip" android:tint="@color/wp_task_chip" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <ImageView android:layout_width="3dp" android:layout_height="match_parent" android:src="@drawable/widget_chip_edge" android:tint="@color/wp_task" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="10dp" android:paddingTop="6dp" android:paddingBottom="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="6dp" android:src="@drawable/ic_kind_task" android:tint="@color/wp_task" android:importantForAccessibility="no" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Send the budget" android:textSize="14sp" android:textColor="@color/wp_fg" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="11 AM" android:textSize="12sp" android:textColor="@color/wp_muted" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </FrameLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tomorrow" android:textSize="13sp" android:textColor="@color/wp_muted" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:paddingStart="16dp" android:paddingTop="6dp" android:paddingBottom="2dp" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="3dp" android:layout_marginBottom="3dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_chip" android:tint="@color/wp_event_chip" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <ImageView android:layout_width="3dp" android:layout_height="match_parent" android:src="@drawable/widget_chip_edge" android:tint="@color/wp_event" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="10dp" android:paddingTop="6dp" android:paddingBottom="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="6dp" android:src="@drawable/ic_kind_event" android:tint="@color/wp_event" android:importantForAccessibility="no" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dentist" android:textSize="14sp" android:textColor="@color/wp_fg" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2 PM – 3 PM · Main St" android:textSize="12sp" android:textColor="@color/wp_muted" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
