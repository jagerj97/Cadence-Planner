<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <include layout="@layout/widget_card_layers" />
    <LinearLayout android:id="@+id/now_body" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="16dp" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/now_header" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/now_heading" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Right now" android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/now_current" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/now_ring" android:layout_width="48dp" android:layout_height="48dp"
                android:layout_marginEnd="12dp" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:id="@+id/now_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="1" android:ellipsize="end" android:textSize="17sp" android:textStyle="bold" />
                <TextView android:id="@+id/now_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="1" android:ellipsize="end" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/now_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="15sp"
            android:text="Looks like you\'ve got some free time!" />
        <!-- Widgets can't use a plain View, so the divider is a one-pixel image. -->
        <ImageView android:id="@+id/now_divider" android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="12dp" android:src="@drawable/widget_line" android:scaleType="fitXY"
            android:importantForAccessibility="no" />
        <LinearLayout android:id="@+id/now_next" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/now_next_dot" android:layout_width="8dp" android:layout_height="8dp"
                android:src="@drawable/widget_dot" android:importantForAccessibility="no" />
            <TextView android:id="@+id/now_next_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:text="Next" android:textSize="15sp" />
            <TextView android:id="@+id/now_next_title" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp" android:maxLines="1" android:ellipsize="end"
                android:textSize="15sp" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/now_next_when" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
