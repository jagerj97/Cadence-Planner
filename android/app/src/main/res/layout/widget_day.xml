<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/card_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_card" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/card_border" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_card_border" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <!-- Sized for a 4x1 cell: the bar with the three totals under it. The heading shows when there's room. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center_vertical"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <TextView android:id="@+id/day_heading" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" android:text="Your day" android:textSize="15sp" android:textStyle="bold" />
        <ImageView android:id="@+id/day_bar" android:layout_width="match_parent" android:layout_height="12dp"
            android:scaleType="fitXY" android:contentDescription="Your day" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center">
            <ImageView android:id="@+id/day_dot_routine" android:layout_width="8dp" android:layout_height="8dp"
                android:src="@drawable/widget_dot" android:importantForAccessibility="no" />
            <TextView android:id="@+id/day_label_routine" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:maxLines="1" android:text="Routines" android:textSize="12sp" />
            <TextView android:id="@+id/day_value_routine" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:maxLines="1" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center">
            <ImageView android:id="@+id/day_dot_planned" android:layout_width="8dp" android:layout_height="8dp"
                android:src="@drawable/widget_dot" android:importantForAccessibility="no" />
            <TextView android:id="@+id/day_label_planned" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:maxLines="1" android:text="Planned" android:textSize="12sp" />
            <TextView android:id="@+id/day_value_planned" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:maxLines="1" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center">
            <ImageView android:id="@+id/day_dot_free" android:layout_width="8dp" android:layout_height="8dp"
                android:src="@drawable/widget_dot" android:importantForAccessibility="no" />
            <TextView android:id="@+id/day_label_free" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:maxLines="1" android:text="Free" android:textSize="12sp" />
            <TextView android:id="@+id/day_value_free" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:maxLines="1" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
