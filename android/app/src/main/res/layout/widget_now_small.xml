<!-- Right now at its narrowest (one column): the ring above the title, centered. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <include layout="@layout/widget_card_layers" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center" android:padding="8dp">
        <ImageView android:id="@+id/now_ring" android:layout_width="40dp" android:layout_height="40dp"
            android:importantForAccessibility="no" />
        <TextView android:id="@+id/now_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:gravity="center" android:maxLines="2" android:ellipsize="end"
            android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/now_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:maxLines="1" android:ellipsize="end" android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
