<!-- Journal. Shown in the widget picker: sample content, since previews get no data. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_card" android:tint="@color/wp_card" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.2"
        android:src="@drawable/widget_card_tint" android:tint="@color/wp_primary" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" >
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="10dp" android:paddingTop="10dp" android:paddingBottom="4dp">
        <TextView android:layout_height="wrap_content" android:text="Journal" android:textSize="15sp" android:textColor="@color/wp_fg" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" android:layout_width="0dp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2 today" android:textSize="13sp" android:textColor="@color/wp_muted" android:maxLines="1" android:ellipsize="end" android:layout_marginEnd="6dp" />
        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:padding="6dp" android:src="@drawable/ic_plus" android:tint="@color/wp_muted" android:importantForAccessibility="no" />
    </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="4dp" android:paddingBottom="4dp">
            <ImageView android:layout_width="3dp" android:layout_height="match_parent" android:layout_marginEnd="10dp" android:src="@drawable/widget_journal_edge" android:tint="@color/wp_primary" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_height="wrap_content" android:text="Morning walk" android:textSize="14sp" android:textColor="@color/wp_fg" android:maxLines="1" android:ellipsize="end" android:layout_width="0dp" android:layout_weight="1" android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8:12 AM" android:textSize="12sp" android:textColor="@color/wp_muted" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="8dp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cool out, the leaves are starting to turn." android:textSize="13sp" android:textColor="@color/wp_muted" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="4dp" android:paddingBottom="4dp">
            <ImageView android:layout_width="3dp" android:layout_height="match_parent" android:layout_marginEnd="10dp" android:src="@drawable/widget_journal_edge" android:tint="@color/wp_primary" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_height="wrap_content" android:text="Sermon notes" android:textSize="14sp" android:textColor="@color/wp_fg" android:maxLines="1" android:ellipsize="end" android:layout_width="0dp" android:layout_weight="1" android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="11:40 AM" android:textSize="12sp" android:textColor="@color/wp_muted" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="8dp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Be still isn&#39;t passive, it&#39;s a choice." android:textSize="13sp" android:textColor="@color/wp_muted" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
