<!-- Tasks. Shown in the widget picker: sample content, since previews get no data. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_card" android:tint="@color/wp_card" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.2"
        android:src="@drawable/widget_card_tint" android:tint="@color/wp_task" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" >
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="10dp" android:paddingTop="10dp" android:paddingBottom="4dp">
        <TextView android:layout_height="wrap_content" android:text="Tasks" android:textSize="15sp" android:textColor="@color/wp_fg" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" android:layout_width="0dp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2 left" android:textSize="13sp" android:textColor="@color/wp_muted" android:maxLines="1" android:ellipsize="end" android:layout_marginEnd="6dp" />
        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:padding="6dp" android:src="@drawable/ic_plus" android:tint="@color/wp_muted" android:importantForAccessibility="no" />
    </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="16dp" android:paddingTop="2dp" android:paddingBottom="2dp">
            <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:padding="8dp" android:layout_marginEnd="2dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/mark_box_done" android:tint="@color/wp_task" android:importantForAccessibility="no" />
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/mark_check" android:tint="@color/wp_card" android:importantForAccessibility="no" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Water the plants" android:textSize="15sp" android:textColor="@color/wp_muted" android:maxLines="1" android:ellipsize="end" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Daily" android:textSize="13sp" android:textColor="@color/wp_muted" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="16dp" android:paddingTop="2dp" android:paddingBottom="2dp">
            <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:padding="8dp" android:layout_marginEnd="2dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/mark_box" android:tint="@color/wp_task" android:importantForAccessibility="no" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Send the budget" android:textSize="15sp" android:textColor="@color/wp_fg" android:maxLines="1" android:ellipsize="end" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="11 AM" android:textSize="13sp" android:textColor="@color/wp_muted" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="16dp" android:paddingTop="2dp" android:paddingBottom="2dp">
            <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:padding="8dp" android:layout_marginEnd="2dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/mark_box" android:tint="@color/wp_task" android:importantForAccessibility="no" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Call Mom" android:textSize="15sp" android:textColor="@color/wp_fg" android:maxLines="1" android:ellipsize="end" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Due Oct 6" android:textSize="13sp" android:textColor="@color/wp_muted" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
