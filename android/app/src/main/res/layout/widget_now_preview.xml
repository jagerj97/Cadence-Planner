<!-- Right now. Shown in the widget picker: sample content, since previews get no data. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_card" android:tint="@color/wp_card" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.2"
        android:src="@drawable/widget_card_tint" android:tint="@color/wp_event" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:gravity="center_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Right now" android:textSize="15sp" android:textColor="@color/wp_fg" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:layout_marginBottom="12dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="12dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_preview_ring" android:importantForAccessibility="no" />
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_kind_meeting" android:tint="@color/wp_event" android:importantForAccessibility="no" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Team meeting" android:textSize="17sp" android:textColor="@color/wp_fg" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="25m left · ends 10:30 AM" android:textSize="13sp" android:textColor="@color/wp_muted" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
        <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:src="@drawable/widget_line" android:tint="@color/wp_line" android:scaleType="fitXY" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/widget_dot" android:tint="@color/wp_task" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Next" android:textSize="15sp" android:textColor="@color/wp_muted" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="8dp" />
            <TextView android:layout_height="wrap_content" android:text="Lunch with Sam" android:textSize="15sp" android:textColor="@color/wp_fg" android:maxLines="1" android:ellipsize="end" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" android:fontFamily="sans-serif-medium" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12 PM · in 1h 30m" android:textSize="13sp" android:textColor="@color/wp_muted" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
