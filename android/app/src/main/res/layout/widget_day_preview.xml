<!-- Your day. Shown in the widget picker: sample content, since previews get no data. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_card" android:tint="@color/wp_card" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.2"
        android:src="@drawable/widget_card_tint" android:tint="@color/wp_primary" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="12dp" android:orientation="horizontal">
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="7" android:layout_marginEnd="2dp" android:alpha="0.72" android:src="@drawable/widget_bar" android:tint="@color/wp_sleep" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" android:layout_marginEnd="2dp" android:alpha="1" android:src="@drawable/widget_bar" android:tint="@color/wp_soft" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3" android:layout_marginEnd="2dp" android:alpha="1" android:src="@drawable/widget_bar" android:tint="@color/wp_primary" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="4" android:layout_marginEnd="2dp" android:alpha="1" android:src="@drawable/widget_bar" android:tint="@color/wp_soft" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" android:layout_marginEnd="2dp" android:alpha="1" android:src="@drawable/widget_bar" android:tint="@color/wp_primary" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3" android:layout_marginEnd="2dp" android:alpha="1" android:src="@drawable/widget_bar" android:tint="@color/wp_soft" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3" android:layout_marginEnd="2dp" android:alpha="0.72" android:src="@drawable/widget_bar" android:tint="@color/wp_sleep" android:scaleType="fitXY" android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center">
                <ImageView android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/widget_dot" android:tint="@color/wp_sleep" android:importantForAccessibility="no" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Routines" android:textSize="12sp" android:textColor="@color/wp_muted" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="4dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10h" android:textSize="13sp" android:textColor="@color/wp_fg" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="4dp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center">
                <ImageView android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/widget_dot" android:tint="@color/wp_primary" android:importantForAccessibility="no" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Planned" android:textSize="12sp" android:textColor="@color/wp_muted" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="4dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5h" android:textSize="13sp" android:textColor="@color/wp_fg" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="4dp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center">
                <ImageView android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/widget_dot" android:tint="@color/wp_muted" android:importantForAccessibility="no" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Free" android:textSize="12sp" android:textColor="@color/wp_muted" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="4dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9h" android:textSize="13sp" android:textColor="@color/wp_fg" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="4dp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
