<resources>
    <style name="CadenceTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F5F5F4</item>
        <item name="android:navigationBarColor">#F5F5F4</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <!-- The widget's panel picker opens as a small dialog over the home screen. -->
    <style name="CadenceWidgetConfig" parent="android:style/Theme.Material.Light.Dialog">
        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>
</resources>
