<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Lets Android 16+ show the running timer as a Live Update (status bar countdown chip). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Reminders fire at their exact time (Android 13+ grants USE_EXACT_ALARM to calendar apps; 12 uses SCHEDULE_EXACT_ALARM). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:label="Cadence"
        android:icon="@mipmap/ic_launcher_plain"
        android:roundIcon="@mipmap/ic_launcher_plain"
        android:theme="@style/CadenceTheme">
        <!-- One copy of the app: the home screen icon, widgets, notifications and shortcuts all bring back
             the one that's open (onNewIntent) instead of starting it fresh. -->
        <activity
            android:name=".AppActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />
        <!-- The app's own icon is the logotype: Android shows it in expanded notifications and can't
             switch it. The home screen icon is the cat (the logomark), or the logotype with "Let Cadence
             outside" on (AppActivity.setPlain). The cat's keeps the old MainActivity name so icons already
             on home screens keep working. -->
        <activity-alias
            android:name=".MainActivity"
            android:targetActivity=".AppActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".PlainLauncher"
            android:targetActivity=".AppActivity"
            android:icon="@mipmap/ic_launcher_plain"
            android:roundIcon="@mipmap/ic_launcher_plain"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <receiver android:name=".Notifications$AlarmReceiver" android:exported="false" />
        <receiver android:name=".FocusTimer$ActionReceiver" android:exported="false" />
        <!-- Home screen widgets, one per Today card (PanelWidgets.java) -->
        <receiver android:name=".PanelWidgets$Now" android:exported="false" android:label="@string/widget_now_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_now" />
        </receiver>
        <receiver android:name=".PanelWidgets$Day" android:exported="false" android:label="@string/widget_day_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_day" />
        </receiver>
        <receiver android:name=".PanelWidgets$Schedule" android:exported="false" android:label="@string/widget_schedule_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_schedule" />
        </receiver>
        <receiver android:name=".PanelWidgets$Agenda" android:exported="false" android:label="@string/widget_agenda_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_agenda" />
        </receiver>
        <receiver android:name=".PanelWidgets$Tasks" android:exported="false" android:label="@string/widget_tasks_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_tasks" />
        </receiver>
        <receiver android:name=".PanelWidgets$Journal" android:exported="false" android:label="@string/widget_journal_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_journal" />
        </receiver>
        <receiver android:name=".PanelWidgets$Habits" android:exported="false" android:label="@string/widget_habits_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_habits" />
        </receiver>
        <receiver android:name=".PanelWidgets$TickReceiver" android:exported="false" />
        <receiver android:name=".PanelWidgets$ItemReceiver" android:exported="false" />
        <service android:name=".PanelWidgets$RowService" android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <service android:name=".PanelWidgets$StripService" android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <service android:name=".PanelWidgets$AgendaService" android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <service android:name=".PanelWidgets$JournalService" android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <receiver android:name=".Notifications$BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
