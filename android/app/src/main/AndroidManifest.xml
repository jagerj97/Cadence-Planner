<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Lets Android 16+ show the running timer as a Live Update (status bar countdown chip). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:label="Cadence"
        android:icon="@drawable/ic_cadence"
        android:theme="@style/CadenceTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".Notifications$AlarmReceiver" android:exported="false" />
        <receiver android:name=".FocusTimer$ActionReceiver" android:exported="false" />
        <!-- Home screen widgets, one per Today card (PanelWidgets.java) -->
        <receiver android:name=".PanelWidgets$Now" android:exported="false" android:label="@string/widget_now_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_now" />
        </receiver>
        <receiver android:name=".PanelWidgets$Day" android:exported="false" android:label="@string/widget_day_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_day" />
        </receiver>
        <receiver android:name=".PanelWidgets$Schedule" android:exported="false" android:label="@string/widget_schedule_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_schedule" />
        </receiver>
        <receiver android:name=".PanelWidgets$Tasks" android:exported="false" android:label="@string/widget_tasks_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_tasks" />
        </receiver>
        <receiver android:name=".PanelWidgets$Habits" android:exported="false" android:label="@string/widget_habits_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_habits" />
        </receiver>
        <receiver android:name=".PanelWidgets$TickReceiver" android:exported="false" />
        <receiver android:name=".PanelWidgets$ItemReceiver" android:exported="false" />
        <service android:name=".PanelWidgets$RowService" android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <service android:name=".PanelWidgets$StripService" android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <receiver android:name=".Notifications$BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
